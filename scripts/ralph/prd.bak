  "userStories": [
    {
      "id": "US-001",
      "title": "Create database schema for brands table",
      "description": "As a developer, I need a brands table to store brand identity, visual guidelines, and voice/tone settings.",
      "acceptanceCriteria": [
        "Create brands table with columns: id (UUID), user_id (UUID), name (VARCHAR 255), business_type (VARCHAR 50), industry (VARCHAR 100), sub_industry (VARCHAR 100), website (VARCHAR 500), social_profiles (JSONB), logo_url (VARCHAR 500), logo_variants (JSONB), visual_guidelines (JSONB), voice_tone (JSONB), created_at, updated_at",
        "Add index on user_id",
        "Enable RLS with policy: users can only access their own brands",
        "Migration runs successfully",
        "Typecheck passes"
      ],
      "priority": 1,
      "passes": true,
      "notes": "Migration at supabase/migrations/20260126000001_create_brands_table.sql with all columns, user_id index, RLS policies for SELECT/INSERT/UPDATE/DELETE, and updated_at trigger."
    },
    {
      "id": "US-002",
      "title": "Create database schema for products table",
      "description": "As a developer, I need a products table to store product catalog with variants and marketing attributes.",
      "acceptanceCriteria": [
        "Create products table with columns: id (UUID), brand_id (UUID FK), product_type (VARCHAR 50), name (VARCHAR 255), short_description (VARCHAR 160), full_description (TEXT), sku (VARCHAR 100), price (DECIMAL 10,2), price_range (VARCHAR 50), images (JSONB), videos (JSONB), variants (JSONB), marketing_attributes (JSONB), created_at, updated_at",
        "Add foreign key to brands with ON DELETE CASCADE",
        "Add index on brand_id",
        "Enable RLS: users can access products of their own brands",
        "Migration runs successfully",
        "Typecheck passes"
      ],
      "priority": 2,
      "passes": true,
      "notes": "Migration at supabase/migrations/20260126000002_create_products_table.sql with all columns, brand_id FK with ON DELETE CASCADE, idx_products_brand_id index, RLS policies (SELECT/INSERT/UPDATE/DELETE) through brands table ownership check, and updated_at trigger."
    },
    {
      "id": "US-003",
      "title": "Create database schema for intelligence_reports table",
      "description": "As a developer, I need an intelligence_reports table to store market data with source attribution.",
      "acceptanceCriteria": [
        "Create intelligence_reports table with columns: id (UUID), brand_id (UUID FK), product_id (UUID FK nullable), report_type (VARCHAR 50), generated_at (TIMESTAMPTZ), expires_at (TIMESTAMPTZ), status (VARCHAR 20 default 'active'), competitors (JSONB), search_trends (JSONB), industry_news (JSONB), social_conversations (JSONB), audience_insights (JSONB), sources (JSONB), created_at, updated_at",
        "Add foreign keys with appropriate cascade behavior",
        "Add indexes on brand_id and product_id",
        "Enable RLS: users can access reports of their own brands",
        "Migration runs successfully",
        "Typecheck passes"
      ],
      "priority": 3,
      "passes": true,
      "notes": "Migration at supabase/migrations/20260126000003_create_intelligence_reports_table.sql with all required columns (id UUID, brand_id FK, product_id FK nullable, report_type, generated_at, expires_at, status default 'active', competitors/search_trends/industry_news/social_conversations JSONB arrays, audience_insights/sources JSONB, timestamps). Foreign keys: brand_id ON DELETE CASCADE, product_id ON DELETE SET NULL. Indexes on brand_id and product_id. RLS policies for SELECT/INSERT/UPDATE/DELETE through brands ownership check. Updated_at trigger."
    },
    {
      "id": "US-004",
