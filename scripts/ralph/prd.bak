      "description": "As a developer, I need a subscriptions table to store Stripe subscription data.",
      "acceptanceCriteria": [
        "Create subscriptions table with columns: id (UUID), user_id (UUID FK to auth.users), stripe_customer_id (VARCHAR 255), stripe_subscription_id (VARCHAR 255 nullable), stripe_price_id (VARCHAR 255 nullable), tier (VARCHAR 50 default 'free'), status (VARCHAR 50 default 'active'), current_period_start (TIMESTAMPTZ nullable), current_period_end (TIMESTAMPTZ nullable), cancel_at_period_end (BOOLEAN default false), brands_limit (INTEGER default 1), personas_limit (INTEGER default 5), images_limit (INTEGER default 20), videos_limit (INTEGER default 5), created_at, updated_at",
        "Add unique index on user_id",
        "Add index on stripe_customer_id",
        "Enable RLS: users can only access their own subscription",
        "Migration runs successfully",
        "Typecheck passes"
      ],
      "priority": 7,
      "passes": true,
      "notes": "Migration at supabase/migrations/20260126000007_create_subscriptions_table.sql with all required columns (id UUID PK, user_id UUID FK to auth.users, stripe_customer_id VARCHAR 255 NOT NULL, stripe_subscription_id/stripe_price_id VARCHAR 255 nullable, tier VARCHAR 50 default 'free', status VARCHAR 50 default 'active', current_period_start/current_period_end TIMESTAMPTZ nullable, cancel_at_period_end BOOLEAN default false, brands_limit INTEGER default 1, personas_limit INTEGER default 5, images_limit INTEGER default 20, videos_limit INTEGER default 5, timestamps). Unique index on user_id (idx_subscriptions_user_id). Index on stripe_customer_id (idx_subscriptions_stripe_customer_id). RLS policies for SELECT/INSERT/UPDATE/DELETE using user_id = auth.uid(). Updated_at trigger."
    },
