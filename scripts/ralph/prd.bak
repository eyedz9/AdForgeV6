      "notes": "Migration at supabase/migrations/20260126000006_create_creatives_table.sql with all required columns (id UUID PK, brand_id UUID FK NOT NULL, product_id/persona_id/audience_id UUID FK nullable, creative_type VARCHAR 20, subtype VARCHAR 50, file_url VARCHAR 500, thumbnail_url VARCHAR 500 nullable, file_size INTEGER nullable, dimensions JSONB nullable, duration_seconds INTEGER nullable, generation_prompt TEXT, generation_params JSONB, generation_model VARCHAR 100, generation_cost DECIMAL 10,4 nullable, headline/subheadline/cta VARCHAR nullable, body_copy TEXT nullable, status VARCHAR 20 default 'generated', rating INTEGER nullable, tags JSONB default '[]', timestamps). Foreign keys: brand_id ON DELETE CASCADE, product_id/persona_id/audience_id ON DELETE SET NULL. Indexes: idx_creatives_brand_id, idx_creatives_persona_id, idx_creatives_type_subtype (composite). RLS policies for SELECT/INSERT/UPDATE/DELETE through brands ownership check. Updated_at trigger."
