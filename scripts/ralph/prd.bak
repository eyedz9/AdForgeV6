      "notes": "Migration at supabase/migrations/20260126000005_create_audiences_table.sql with all required columns (id UUID PK, persona_id UUID FK NOT NULL, brand_id UUID FK NOT NULL, name VARCHAR 255, meta_targeting/google_targeting/linkedin_targeting/tiktok_targeting/pinterest_targeting/snapchat_targeting/size_estimates JSONB, last_exported_at TIMESTAMPTZ nullable, export_count INTEGER default 0, timestamps). Foreign keys: both persona_id and brand_id ON DELETE CASCADE. Indexes on persona_id and brand_id. RLS policies for SELECT/INSERT/UPDATE/DELETE through brands ownership check. Updated_at trigger."
