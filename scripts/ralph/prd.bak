        "Enable RLS: users can only access their own usage",
        "Migration runs successfully",
        "Typecheck passes"
      ],
      "priority": 8,
      "passes": true,
      "notes": "Migration at supabase/migrations/20260126000008_create_usage_tracking_table.sql with all required columns (id UUID PK, user_id UUID FK to auth.users ON DELETE CASCADE, period_start DATE NOT NULL, period_end DATE NOT NULL, personas_generated/images_generated/videos_generated/intelligence_reports INTEGER default 0, personas_limit/images_limit/videos_limit INTEGER NOT NULL, timestamps). Unique constraint on (user_id, period_start) via idx_usage_tracking_user_period UNIQUE INDEX. Additional indexes: idx_usage_tracking_user_id, idx_usage_tracking_period_start. RLS policies for SELECT/INSERT/UPDATE/DELETE using user_id = auth.uid(). Updated_at trigger."
    },
